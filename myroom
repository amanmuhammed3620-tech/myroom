<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>3D Room Interior Viewer</title>
  <style>
    body { margin: 0; overflow: hidden; background: #1a1a1a; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
    #canvas-container { width: 100vw; height: 100vh; }
    #ui {
      position: absolute; top: 16px; left: 16px; color: #fff;
      background: rgba(18, 18, 20, 0.85); backdrop-filter: blur(8px);
      padding: 14px 18px; border-radius: 10px; font-size: 13px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.4); max-width: 320px;
    }
    #ui h2 { margin: 0 0 6px 0; font-size: 16px; color: #e8d8c8; font-weight: 600; }
    #ui p { margin: 4px 0; color: #b5b5b5; line-height: 1.4; }
    .controls { margin-top: 10px; display: flex; gap: 8px; flex-wrap: wrap; }
    button {
      background: #2b2b30; color: #e5e5e5; border: 1px solid #444;
      padding: 6px 12px; border-radius: 6px; cursor: pointer; font-size: 12px;
      transition: all 0.2s;
    }
    button:hover { background: #d4a373; color: #111; border-color: #d4a373; }
  </style>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
</head>
<body>
  <div id="ui">
    <h2>3D Masterplan Viewer</h2>
    <p>• <b>Left-Click + Drag:</b> Rotate view (360°)</p>
    <p>• <b>Right-Click + Drag:</b> Pan across room</p>
    <p>• <b>Scroll:</b> Zoom In / Out</p>
    <div class="controls">
      <button onclick="setView('iso')">Isometric View</button>
      <button onclick="setView('top')">Top-Down Plan</button>
      <button onclick="setView('bed')">Bed Perspective</button>
      <button onclick="setView('door')">Entrance View</button>
    </div>
  </div>
  <div id="canvas-container"></div>

  <script>
    // Room Coordinates & Dimensions (1 unit = 1 meter)
    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x181716);

    const camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 100);
    const renderer = new THREE.WebGLRenderer({ antialias: true });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;
    document.getElementById('canvas-container').appendChild(renderer.domElement);

    const controls = new THREE.OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;
    controls.dampingFactor = 0.05;

    // Materials Palette (Warm Modern / Soft Luxe)
    const floorMat = new THREE.MeshStandardMaterial({ color: 0xede6dc, roughness: 0.35, metalness: 0.05 });
    const wallMat = new THREE.MeshStandardMaterial({ color: 0xf5f0ea, roughness: 0.85 });
    const bedBaseMat = new THREE.MeshStandardMaterial({ color: 0x7a6352, roughness: 0.7 });
    const beddingMat = new THREE.MeshStandardMaterial({ color: 0xd9c5b2, roughness: 0.8 });
    const goldArchMat = new THREE.MeshStandardMaterial({ color: 0xc9a979, roughness: 0.4, metalness: 0.3 });
    const mirrorMat = new THREE.MeshStandardMaterial({ color: 0x88949e, metalness: 0.9, roughness: 0.1 });
    const woodMat = new THREE.MeshStandardMaterial({ color: 0xbaa48e, roughness: 0.6 });
    const darkWoodMat = new THREE.MeshStandardMaterial({ color: 0x4a4038, roughness: 0.7 });
    const glowMat = new THREE.MeshBasicMaterial({ color: 0xffe2b3 });

    // 1. Floor Generation (L-shape taking into account the 2m x 0.8m recess)
    const floorShape = new THREE.Shape();
    floorShape.moveTo(0, 0);
    floorShape.lineTo(4.5, 0);       // Top wall (4.50m)
    floorShape.lineTo(4.5, -5.3);    // Right wall (5.30m)
    floorShape.lineTo(0.88, -5.3);   // Bottom wall (3.62m -> 4.5 - 3.62 = 0.88)
    floorShape.lineTo(0.88, -2.0);   // Long left wall up to doorway notch
    floorShape.lineTo(0, -2.0);      // 80cm step into the niche
    floorShape.closePath();

    const floorGeo = new THREE.ShapeGeometry(floorShape);
    const floorMesh = new THREE.Mesh(floorGeo, floorMat);
    floorMesh.rotation.x = -Math.PI / 2;
    floorMesh.receiveShadow = true;
    scene.add(floorMesh);

    // 2. King Bed & Triple Arched Wall (On Long Left Wall)
    const bedGroup = new THREE.Group();

    // Bed frame & mattress
    const bedBase = new THREE.Mesh(new THREE.BoxGeometry(2.1, 0.35, 1.9), bedBaseMat);
    bedBase.position.set(0, 0.18, 0);
    bedBase.castShadow = true;
    bedBase.receiveShadow = true;
    bedGroup.add(bedBase);

    const mattress = new THREE.Mesh(new THREE.BoxGeometry(1.95, 0.28, 1.8), beddingMat);
    mattress.position.set(0, 0.45, 0.02);
    mattress.castShadow = true;
    bedGroup.add(mattress);

    const headboard = new THREE.Mesh(new THREE.BoxGeometry(0.2, 1.1, 1.9), bedBaseMat);
    headboard.position.set(-1.0, 0.65, 0);
    bedGroup.add(headboard);

    // Nightstands
    const ns1 = new THREE.Mesh(new THREE.BoxGeometry(0.45, 0.45, 0.5), woodMat);
    ns1.position.set(-0.85, 0.22, 1.35);
    const ns2 = new THREE.Mesh(new THREE.BoxGeometry(0.45, 0.45, 0.5), woodMat);
    ns2.position.set(-0.85, 0.22, -1.35);
    bedGroup.add(ns1);
    bedGroup.add(ns2);

    // Feature Arches
    // Center Arch
    const centerArch = new THREE.Mesh(new THREE.CylinderGeometry(0.9, 0.9, 0.05, 32, 1, false, 0, Math.PI), goldArchMat);
    centerArch.rotation.z = -Math.PI / 2;
    centerArch.rotation.y = Math.PI / 2;
    centerArch.position.set(-1.08, 1.8, 0);
    bedGroup.add(centerArch);

    // LED backlight strip effect
    const ledGlow = new THREE.Mesh(new THREE.TorusGeometry(0.92, 0.02, 16, 32, Math.PI), glowMat);
    ledGlow.rotation.y = Math.PI / 2;
    ledGlow.position.set(-1.06, 1.8, 0);
    bedGroup.add(ledGlow);

    // Left Arch (Mirror)
    const mirrorArch = new THREE.Mesh(new THREE.BoxGeometry(0.04, 2.0, 0.6), mirrorMat);
    mirrorArch.position.set(-1.08, 1.0, -1.35);
    bedGroup.add(mirrorArch);

    // Right Arch (Hanging pendant light)
    const pendantArch = new THREE.Mesh(new THREE.BoxGeometry(0.04, 2.1, 0.6), woodMat);
    pendantArch.position.set(-1.08, 1.05, 1.35);
    bedGroup.add(pendantArch);

    // Drop pendant fixture
    const dropCord = new THREE.Mesh(new THREE.CylinderGeometry(0.005, 0.005, 1.2), darkWoodMat);
    dropCord.position.set(-0.85, 1.5, 1.35);
    const bulb = new THREE.Mesh(new THREE.SphereGeometry(0.1, 16, 16), glowMat);
    bulb.position.set(-0.85, 0.9, 1.35);
    bedGroup.add(dropCord);
    bedGroup.add(bulb);

    // Place Bed Group along the 0.88m setback wall
    bedGroup.position.set(1.95, 0, 3.65);
    scene.add(bedGroup);

    // 3. Built-In Wardrobe (In the 2m x 0.8m Niche)
    const wardrobe = new THREE.Mesh(new THREE.BoxGeometry(0.7, 2.7, 1.9), darkWoodMat);
    wardrobe.position.set(0.4, 1.35, 1.0);
    wardrobe.castShadow = true;
    scene.add(wardrobe);

    // 4. Floating Vanity / Study Desk (Top Wall: 4.5m)
    const vanity = new THREE.Mesh(new THREE.BoxGeometry(1.4, 0.1, 0.45), woodMat);
    vanity.position.set(3.0, 0.75, 0.25);
    const vanityMirror = new THREE.Mesh(new THREE.CylinderGeometry(0.35, 0.35, 0.03, 32), mirrorMat);
    vanityMirror.rotation.x = Math.PI / 2;
    vanityMirror.position.set(3.0, 1.35, 0.05);
    scene.add(vanity);
    scene.add(vanityMirror);

    // 5. Low-Profile Media Console (Bottom Wall: 3.62m)
    const tvUnit = new THREE.Mesh(new THREE.BoxGeometry(1.8, 0.3, 0.35), woodMat);
    tvUnit.position.set(2.7, 0.2, 5.15);
    scene.add(tvUnit);

    // 6. Floor-to-Ceiling Ripple Curtains (Right Wall Window)
    const curtainGeo = new THREE.BoxGeometry(0.12, 2.8, 2.2);
    const curtainMat = new THREE.MeshStandardMaterial({ color: 0xc7b8a5, roughness: 0.9 });
    const curtain = new THREE.Mesh(curtainGeo, curtainMat);
    curtain.position.set(4.4, 1.4, 3.2);
    scene.add(curtain);

    // Lighting Setup
    const ambientLight = new THREE.AmbientLight(0xffeedd, 0.5);
    scene.add(ambientLight);

    const warmPoint = new THREE.PointLight(0xffbe85, 1.2, 8);
    warmPoint.position.set(2.2, 2.2, 3.5);
    warmPoint.castShadow = true;
    scene.add(warmPoint);

    const windowLight = new THREE.DirectionalLight(0xffffff, 0.7);
    windowLight.position.set(8, 4, 3);
    windowLight.castShadow = true;
    scene.add(windowLight);

    // Camera preset switcher
    function setView(view) {
      if (view === 'iso') {
        camera.position.set(6.5, 5.5, 7.5);
        controls.target.set(2.25, 1.2, 2.65);
      } else if (view === 'top') {
        camera.position.set(2.25, 9.0, 2.65);
        controls.target.set(2.25, 0, 2.65);
      } else if (view === 'bed') {
        camera.position.set(3.8, 1.4, 3.65);
        controls.target.set(0.9, 1.2, 3.65);
      } else if (view === 'door') {
        camera.position.set(0.9, 1.6, 2.1);
        controls.target.set(3.2, 1.2, 4.0);
      }
    }

    setView('iso');

    window.addEventListener('resize', () => {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
    });

    function animate() {
      requestAnimationFrame(animate);
      controls.update();
      renderer.render(scene, camera);
    }
    animate();
  </script>
</body>
</html>
